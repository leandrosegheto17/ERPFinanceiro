# .env.example — TASK-005 (Setup Supabase local + segredos de CI)
#
# Copie para `.env` (nunca commitado — ver .gitignore) e preencha com os
# valores impressos por `supabase start` / `supabase status` no seu ambiente
# local. Em CI, cada valor equivalente vem de GitHub Actions Secrets — ver
# docs/ci-secrets.md.
#
# REGRA INEGOCIÁVEL (GUARDRAILS.md G-10 / TASK.md DI-09):
# Qualquer variável com prefixo VITE_ é inlinada pelo Vite no bundle
# publicado e fica visível a qualquer pessoa que abrir o app no navegador.
# Nunca colocar aqui (nem em nenhuma variável VITE_*) chave de service role,
# chave VAPID privada, connection string privilegiada do Postgres, ou
# qualquer outro segredo de serviço. Essas variáveis (sem prefixo VITE_)
# só existem no ambiente do servidor/CI e nunca chegam ao bundle do cliente
# — o teste de grep do bundle (TASK-005 placeholder, TASK-042 versão final)
# existe justamente para pegar essa violação automaticamente.

# --- Variáveis públicas do cliente (seguro aparecer no bundle) ---------

# URL da API do Supabase local (impressa por `supabase status` como API_URL).
VITE_SUPABASE_URL=http://127.0.0.1:54421

# Chave anônima (anon/publishable key) do Supabase local — pensada para ser
# pública; a autorização real fica em Row Level Security (RLS) no Postgres,
# nunca no segredo desta chave.
VITE_SUPABASE_ANON_KEY=

# --- Segredos de servidor (NUNCA usar prefixo VITE_, NUNCA no bundle) ---
# Usados só por `jobs/*`, `tools/*` server-side e pelo pipeline de CI —
# nunca importados por código de `core/*` ou `features/*` do cliente.

# Chave de service role do Supabase local/remoto (bypassa RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Connection string privilegiada usada por migrations/jobs server-side.
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# Token de acesso da CLI do Supabase, usado em CI para `supabase link`/`db push`
# contra o projeto remoto (não confundir com as chaves acima).
SUPABASE_ACCESS_TOKEN=

# Par de chaves VAPID para Web Push (TASK-056/057). A pública pode ir para o
# cliente (não é segredo); a privada nunca.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
