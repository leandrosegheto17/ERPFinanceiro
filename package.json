{
  "name": "estudobiblico",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src e2e eslint.config.js vite.config.ts vitest.config.ts playwright.config.ts && npm run lint:deps",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:db": "node --test tests/db/*.test.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toast": "^1.2.23",
    "@supabase/supabase-js": "^2.116.0",
    "dexie": "^4.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "pg": "^8.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.0"
  }
}
