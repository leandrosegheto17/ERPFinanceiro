<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Projeto descartável (T-34, mesma disciplina de spikes/T-01-firebird-spike): sobe a API real
    (ApiHost + Startup + CompositionRoot.Construir(), T-26/T-27) contra Firebird embarcado real,
    semeia um punhado de vendas conhecidas e fica no ar numa porta livre até receber Enter (ou até
    o arquivo "parar.txt" aparecer na pasta de saída), para permitir rodar curl real de fora.
    Não faz parte da ERPFinanceiro.sln (não é código de produção nem teste automatizado) — só
    ferramenta de apoio para produzir a evidência de execução real de T-34.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <RootNamespace>T34SmokeHarness</RootNamespace>
    <AssemblyName>T34SmokeHarness</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ERPFinanceiro.Domain\ERPFinanceiro.Domain.csproj" />
    <ProjectReference Include="..\..\src\ERPFinanceiro.Application\ERPFinanceiro.Application.csproj" />
    <ProjectReference Include="..\..\src\ERPFinanceiro.Infrastructure\ERPFinanceiro.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ERPFinanceiro.Api\ERPFinanceiro.Api.csproj" />
    <ProjectReference Include="..\..\src\ERPFinanceiro.Desktop\ERPFinanceiro.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" Version="6.5.0" />
    <PackageReference Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Configuration" />
  </ItemGroup>

  <ItemGroup>
    <!-- DLLs nativas do Firebird embarcado, mesmo contorno de ERPFinanceiro.Tests.csproj (T-12). -->
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\fbclient.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\fbembed.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\ib_util.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\icudt52.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\icuin52.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\icuuc52.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\msvcp100.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\msvcr100.dll;
                    ..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\zlib1.dll"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\fbclient.dll')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\*.dat"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\*.conf"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48')"
          Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\firebird.msg"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\firebird.msg')"
          Link="firebird.msg" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\plugins\*.*"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\plugins')"
          Link="plugins\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\intl\*.*"
          Condition="Exists('..\..\spikes\T-01-firebird-spike\FirebirdSpike\bin\Debug\net48\intl')"
          Link="intl\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!--
    App.config real é gitignorado (regra global do .gitignore, T-04: "Segredos locais: só o
    .example é versionado") — mesma convenção de ERPFinanceiro.Desktop/Tests. Só
    App.config.example é versionado aqui; copie-o para App.config antes de buildar/rodar
    (README.md de docs/postman/ documenta os valores usados na evidência de execução desta
    tarefa). O SDK inclui App.config automaticamente por convenção (net48) quando o arquivo
    existir localmente — sem item explícito necessário no .csproj.
  -->
  <ItemGroup>
    <None Include="App.config.example">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
